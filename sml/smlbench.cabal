cabal-version: 2.4
name:          smlbench
version:       0.1
synopsis:      Haskell translations of the 3CPS SML benchmarks
-- Generated by tools/gen.py: one executable per translated program

common prog
  default-language: Haskell2010
  build-depends:    base, containers, array, deepseq
  hs-source-dirs:   progs
  other-modules:    Repeat

executable ack
  import:  prog
  main-is: Ack.hs

executable tak
  import:  prog
  main-is: Tak.hs

executable cpstak
  import:  prog
  main-is: Cpstak.hs

executable y-fact
  import:  prog
  main-is: YFact.hs

executable nqueens
  import:  prog
  main-is: Nqueens.hs

executable mandelbrot
  import:  prog
  main-is: Mandelbrot.hs

executable quicksort
  import:  prog
  main-is: Quicksort.hs

executable filter
  import:  prog
  main-is: Filter.hs

executable derivative
  import:  prog
  main-is: Derivative.hs

executable streams
  import:  prog
  main-is: Streams.hs

executable tardis
  import:  prog
  main-is: Tardis.hs

executable interpreter
  import:  prog
  main-is: Interpreter.hs

executable parser-comb
  import:  prog
  main-is: ParserComb.hs
