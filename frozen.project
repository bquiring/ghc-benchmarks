-- Version pins for the small group (happy, alex, cpphs, skylighting): every
-- non-boot dependency as built in dist-base22 (from its plan.json), with
-- flags.  cabal.project imports cached.project (gen-constraints.py), which
-- pins the newest version in ~/.cabal/packages; with the laptop's cache
-- that gives exactly these.  With another cache, use this file instead:
-- replace `import: cached.project` with `import: frozen.project`.
constraints:
  any.aeson ==2.3.2.0,
  aeson +ordered-keymap,
  any.aeson-pretty ==0.8.9,
  aeson-pretty -lib-only,
  any.ansi-terminal ==1.1.5,
  ansi-terminal -example,
  any.ansi-terminal-types ==1.1.3,
  any.appar ==0.1.8,
  any.asn1-encoding ==0.9.6,
  any.asn1-parse ==0.9.5,
  any.asn1-types ==0.3.4,
  any.assoc ==1.1.1,
  assoc -tagged,
  any.async ==2.2.6,
  async -bench -debug-auto-label,
  any.attoparsec ==0.14.4,
  attoparsec -developer,
  any.attoparsec-iso8601 ==1.0.2.1,
  attoparsec-iso8601 -developer -fast,
  any.auto-update ==0.1.6,
  any.base-compat ==0.15.0,
  any.base-compat-batteries ==0.15.0,
  any.base-orphans ==0.9.4,
  any.base16-bytestring ==1.0.2.0,
  any.base64 ==0.4.2.3,
  any.base64-bytestring ==1.2.1.0,
  any.basement ==0.0.14,
  any.bifunctors ==5.6.3,
  bifunctors +tagged,
  any.bitvec ==1.1.6.0,
  bitvec +simd,
  any.blaze-builder ==0.4.2.2,
  any.blaze-html ==0.9.1.2,
  any.blaze-markup ==0.8.2.8,
  any.boring ==0.2.2.1,
  boring +tagged,
  any.bsb-http-chunked ==0.0.0.4,
  any.byteorder ==1.0.4,
  any.call-stack ==0.4.0,
  any.case-insensitive ==1.2.1.0,
  any.cereal ==0.5.8.3,
  cereal -bytestring-builder,
  any.character-ps ==0.1,
  any.citeproc ==0.8.0.1,
  citeproc -executable -icu,
  any.cmdargs ==0.10.22,
  cmdargs +quotation -testprog,
  any.colour ==2.3.7,
  any.commonmark ==0.2.2,
  any.commonmark-extensions ==0.2.3.2,
  any.commonmark-pandoc ==0.2.1.2,
  any.comonad ==5.0.10,
  comonad +containers +distributive +indexed-traversable,
  any.conduit ==1.3.4.2,
  any.conduit-extra ==1.3.6,
  any.connection ==0.3.1,
  any.constraints ==0.14.4,
  any.contravariant ==1.5.6,
  contravariant +statevar,
  any.cookie ==0.4.5,
  any.cryptonite ==0.30,
  cryptonite -check_alignment +integer-gmp -old_toolchain_inliner +support_aesni +support_deepseq -support_pclmuldq +support_rdrand -support_sse +use_target_attributes,
  any.data-default ==0.8.0.2,
  any.data-default-class ==0.2.0.0,
  any.data-fix ==0.3.4,
  any.dec ==0.0.5,
