 >                    | otherwise   = Set.unions [ joinSymSets currFstSet rhs
 >                                               | rl <- prodsOfName s
 >                                               , let Production _ rhs _ _ = prodNo rl ]
+
+
+The list lookup, local so that GHC can specialise it to the key type (webs
+proposal 8 experiment: base's lookup has no unfolding, so its Eq dictionary
+calls stay unknown):
+
+> lookup :: Eq a => a -> [(a, b)] -> Maybe b
+> lookup _ [] = Nothing
+> lookup k ((a, b) : r)
+>   | k == a    = Just b
+>   | otherwise = lookup k r
